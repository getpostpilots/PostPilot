# Set to true to bypass Supabase auth entirely and run the whole app against
# an in-memory fixture (src/lib/demo-data.ts) - no backend setup needed.
# Nothing persists past a dev-server restart. Leave unset/false for real use.
VITE_DEMO_MODE=false

# Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Service role key. Server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 32-byte key (base64) used to encrypt LinkedIn tokens and BYO AI keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# LinkedIn app (developer.linkedin.com) - "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" products
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Public site URL, used to build OAuth redirects and email links
VITE_SITE_URL=http://localhost:3000

# Stock video search for video posts (both optional but at least one needed
# for video-enabled pillars/campaigns to find anything) - free tier keys:
# api.pexels.com/api and pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=
